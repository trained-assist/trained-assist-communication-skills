{
  "name": "trained-assist-communication-skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: MCP-методы для state-first цепочки диалога, генерации следующего сообщения и выбора из заданных решений, без VM",
  "scripts": {
    "check": "node --check src/*.mjs src/mcp/*.mjs scripts/corpus/run.mjs scripts/benchmark/run.mjs",
    "test": "node --test test/*.test.mjs",
    "sandbox": "bash scripts/sandbox/run.sh",
    "corpus": "node scripts/corpus/run.mjs --offline --verbose",
    "corpus:live": "node scripts/corpus/run.mjs --live --verbose",
    "benchmark": "node scripts/benchmark/run.mjs --offline --verbose",
    "benchmark:live": "node scripts/benchmark/run.mjs --live --verbose",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "gate": "npm run check && npm test && npm run sandbox"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=22"
  }
}
